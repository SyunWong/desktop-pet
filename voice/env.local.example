# Required for voice chat. Managed by Agora CLI; see README for login/project setup.
# From repository root:
# agora project env write voice/.env.local --template nextjs --project "YOUR_PROJECT_ID_OR_NAME"
NEXT_PUBLIC_AGORA_APP_ID=
NEXT_AGORA_APP_CERTIFICATE=

# Optional. Both keys reproduce the English DeepSeek + Fish Audio demo.
# Without these, code uses Agora-managed OpenAI / MiniMax providers.
DEEPSEEK_API_KEY=
FISH_AUDIO_API_KEY=
